+// [[Rcpp::export]]
+SEXP cpp_gmap_prepare_matrix(Rcpp::NumericMatrix matrix, Rcpp::DataFrame metadata,
+    Rcpp::NumericVector indices, Rcpp::List region, std::string reference,
+    double sample_count, Rcpp::List eigen_control, bool dense) {
+  using namespace Rcpp;
+  CharacterVector ids=metadata["marker_id"], chr=metadata["chromosome"],
+    a1=metadata["allele1"], a2=metadata["allele2"];
+  NumericVector positions=metadata["base_pair_position"];
+  const auto n=static_cast<size_t>(ids.size());
+  if(matrix.nrow()!=int(n)||matrix.ncol()!=int(n)||indices.size()!=int(n) ||
+      !std::isfinite(sample_count)||sample_count<2||sample_count!=std::floor(sample_count))
+    stop("Invalid dense region dimensions or reference sample count");
+  gmat::SparseLdRegion data;
+  data.reference_sample_count=static_cast<uint64_t>(sample_count);
+  data.matrix=as<std::vector<double>>(matrix);
+  std::vector<uint64_t> selected;
+  for(size_t j=0;j<n;++j) {
+    const double index=indices[j];
+    if(!std::isfinite(index)||index<1||index!=std::floor(index))stop("Invalid dense region index");
+    selected.push_back(static_cast<uint64_t>(index-1));
+    data.markers.push_back({as<std::string>(ids[j]),as<std::string>(chr[j]),
+      static_cast<uint64_t>(positions[j]),as<std::string>(a1[j]),as<std::string>(a2[j]),0,selected.back()});
+  }
+  gmap::Region r;
+  r.id=as<std::string>(region["id"]);r.chromosome=as<std::string>(region["chromosome"]);
+  r.assembly=as<std::string>(region["assembly"]);
+  r.start=as<double>(region["start"]);r.end=as<double>(region["end"]);
+  gsolve::SymmetricEigensystemOptions options;
+  options.maximum_dimension=as<double>(eigen_control["maximum_dimension"]);
+  options.symmetry_tolerance=as<double>(eigen_control["symmetry_tolerance"]);
+  options.verification_tolerance=as<double>(eigen_control["verification_tolerance"]);
+  auto prepared=dense ? gmap::PreparedMappingRegion::from_dense_ld(std::move(data),r,
+    reference,selected,false,options) : gmap::PreparedMappingRegion::from_ld(std::move(data),r,
+    reference,selected,false,0,nullptr,options);
+  return XPtr<gmap::PreparedMappingRegion>(new gmap::PreparedMappingRegion(std::move(prepared)),true);
+}

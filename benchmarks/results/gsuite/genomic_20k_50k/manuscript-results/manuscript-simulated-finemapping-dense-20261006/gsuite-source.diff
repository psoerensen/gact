+// [[Rcpp::export]]
+Rcpp::List cpp_gmap_qgg_sets(Rcpp::NumericMatrix matrix,
+    Rcpp::CharacterVector marker_ids, Rcpp::NumericVector pip,
+    double threshold, double minimum_r2, double cutoff, std::string method) {
+  using namespace Rcpp;
+  if(method!="CS2"&&method!="CS3")stop("cs_method must be CS2 or CS3");
+  gmap::RegionalLd ld{as<std::vector<std::string>>(marker_ids),
+    as<std::vector<double>>(matrix),false};
+  if(matrix.nrow()!=marker_ids.size()||matrix.ncol()!=marker_ids.size())
+    stop("LD dimensions differ from marker IDs");
+  gmap::MarginalSetControls c;
+  c.coverage=threshold;c.min_r2=minimum_r2;c.pip_cutoff=cutoff;
+  c.lead=method=="CS3" ? gmap::LeadSelection::ld_pip : gmap::LeadSelection::pip;
+  return sets(gmap::make_qgg_marginal_sets(as<std::vector<double>>(pip),ld,c));
+}

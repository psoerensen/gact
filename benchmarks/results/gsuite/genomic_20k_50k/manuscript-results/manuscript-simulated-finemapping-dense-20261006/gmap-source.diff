+// Grouping behavior adapted from qgg R/genomic_bayes.R::crs,
+// Copyright Peter Sorensen, GPL-3. The installed qgg oracle is archived in
+// the gact comparison evidence; no qgg runtime dependency is introduced.
+PosteriorSets make_qgg_marginal_sets(const std::vector<double>& input,
+ const RegionalLd& ld,const MarginalSetControls& c) {
+ validate_ld(ld);validate_weights(input,ld.marker_ids.size());coverage(c.coverage);
+ probability(c.min_r2);probability(c.pip_cutoff);
+ if(c.lead!=LeadSelection::pip&&c.lead!=LeadSelection::ld_pip)
+   throw std::invalid_argument("Invalid qgg lead mode");
+ auto p=input;const auto n=p.size();
+ for(double& x:p)if(x<c.pip_cutoff)x=0;
+ auto score=p;
+ if(c.lead==LeadSelection::ld_pip) {
+   std::fill(score.begin(),score.end(),0);
+   for(std::size_t j=0;j<n;++j)for(std::size_t k=0;k<n;++k)score[j]+=r2(ld,j,k)*p[k];
+ }
+ std::vector<std::size_t> order(n);std::iota(order.begin(),order.end(),0);
+ order=rank(std::move(order),score);
+ PosteriorSets out;out.marker_ids=ld.marker_ids;out.marginal_controls=c;
+ out.incomplete_ld_reference=ld.incomplete_reference;
+ for(auto lead:order) {
+   std::vector<std::size_t> neighbours,candidates;double mass=0;
+   for(auto j:order)if(r2(ld,lead,j)>c.min_r2) {
+     neighbours.push_back(j);mass+=p[j];if(p[j]>0)candidates.push_back(j);
+   }
+   if(mass<c.coverage||candidates.empty())continue;
+   auto selected=select(candidates,p,c.coverage);
+   auto s=describe(selected,p,ld,lead,c.coverage,c.min_r2);
+   s.source_index=out.sets.size();s.remaining_mass_before=std::accumulate(p.begin(),p.end(),0.0);
+   for(auto j:neighbours)p[j]=0;
+   s.remaining_mass_after=std::accumulate(p.begin(),p.end(),0.0);
+   out.sets.push_back(std::move(s));
+ }
+ duplicates(out);return out;
+}
